PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:55432/seats?sslmode=disable
# Both must be >= 16 chars; the server refuses to start otherwise.
JWT_SECRET=dev-jwt-secret-change-me-please
ADMIN_API_KEY=dev-admin-key-change-me-please
DB_MAX_CONNS=20
TOKEN_TTL=24h
LOG_LEVEL=info
AUDIT_INTERVAL=30s
DRAIN_DELAY=2s
SHUTDOWN_TIMEOUT=10s
